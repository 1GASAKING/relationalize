{
  "name": "@relationalize/node",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A full TypeScript/Node replica of the relationalize + rtdb_bridge Python packages: JSON collections -> relational tables -> bridge envelope + SQL DDL.",
  "license": "MIT",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./relationalize": {
      "types": "./dist/src/relationalize/index.d.ts",
      "default": "./dist/src/relationalize/index.js"
    },
    "./rtdb_bridge": {
      "types": "./dist/src/rtdb_bridge/index.d.ts",
      "default": "./dist/src/rtdb_bridge/index.js"
    }
  },
  "bin": {
    "rtdb-bridge": "./bin/rtdb-bridge.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "gen:schemas": "node scripts/generate-schema-data.mjs",
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "parity": "npm run build && node scripts/parity-check.mjs",
    "examples": "npm run build && node ../examples/node/rtdb_conversion_test.mjs && node ../examples/node/rtdb_schema_tree.mjs",
    "examples:all": "npm run build && node ../examples/node/run-all.mjs",
    "cli": "node ./bin/rtdb-bridge.js",
    "prepublishOnly": "npm run gen:schemas && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
